# ================================================
# 剧本杀城市娱乐热度分析系统 - 环境配置模板
# ================================================
# 使用方法：复制本文件为 .env，并根据实际情况修改配置值
#   cp .env.example .env
# ================================================

# ------------------------------------------------
# 高德地图 API 配置
# ------------------------------------------------
# 高德开放平台 Web 服务 API Key（后端爬虫地理编码使用）
# 申请地址：https://console.amap.com/dev/key/app
GAODE_API_KEY=your_gaode_web_service_api_key_here

# 高德开放平台 JS API Key（前端地图组件使用）
# 申请地址：https://console.amap.com/dev/key/app
GAODE_JS_API_KEY=your_gaode_javascript_api_key_here

# ------------------------------------------------
# 数据模式配置
# ------------------------------------------------
# 数据运行模式：demo 或 real
#   demo: 使用预置的模拟数据，无需实际爬取
#   real: 启用真实爬虫抓取大众点评数据
DATA_MODE=demo

# 是否使用模拟数据：true 或 false
#   true: 跳过真实爬虫，直接返回演示数据（推荐用于开发/演示）
#   false: 调用 Playwright 真实爬取大众点评页面
USE_MOCK_DATA=true

# ------------------------------------------------
# 后端服务配置
# ------------------------------------------------
# API 服务监听地址
#   0.0.0.0: 允许外部访问
#   127.0.0.1: 仅本地访问
API_HOST=0.0.0.0

# API 服务端口号
API_PORT=8100
