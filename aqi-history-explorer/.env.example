# 中国环境监测总站配置（可选，已使用模拟数据）
CNEMC_USERNAME=your_username
CNEMC_PASSWORD=your_password

# 火山大模型API配置（可选，已支持模拟模式）
# RESTful API方式，只需配置API Key
# 模型获取: https://console.volcengine.com/ark/region:ark+cn-beijing/model
VOLCENGINE_API_KEY=your_api_key_here
VOLCENGINE_MODEL=doubao-seed-2-0-code
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
