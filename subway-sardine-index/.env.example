# 高德地图Web服务API Key（用于交通态势、POI搜索等Web服务）
# 需要申请 Web服务类型的Key，勾选「交通态势」服务权限
GAODE_TRAFFIC_KEY=your_amap_web_service_key_here

# 备用API Key - 系统会自动尝试多个Key，第一个失败时自动切换
GAODE_GEOCODE_KEY=your_second_key_here
GAODE_JS_API_KEY=your_third_key_here

# 高德地图开放平台申请地址: https://console.amap.com/dev/key/app
# 注意：Web服务Key和JS API Key不能混用，Web服务需要申请「Web服务」类型
