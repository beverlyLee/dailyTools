# 火山引擎API配置
ARK_API_KEY=your_ark_api_key_here
ARK_MODEL_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=ep-20241201123456-abcde

# 爬虫配置
USE_MOCK_DATA=true
CRAWLER_INTERVAL=3600
CRAWLER_JD_ENABLED=true
CRAWLER_TM_ENABLED=true

# 数据库配置
DATABASE_PATH=./data/baijiu.db

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
