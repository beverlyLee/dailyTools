# ============================================================
# 外卖营养分析器 - 配置文件
# ============================================================
# 复制此文件为 .env，并填入你的配置值

# ============================================================
# 火山引擎 AI 建议配置
# ============================================================
# 火山引擎 API 密钥 (必填)
# 在 https://www.volcengine.com/product/ark 申请
ARK_API_KEY=your_ark_api_key_here

# 火山引擎 API 端点
# 默认为: https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 模型名称
# 默认为 doubao-pro-32k
ARK_MODEL=doubao-pro-32k

# AI 调用最大重试次数
# 默认 2 次
AI_MAX_RETRIES=2

# AI 调用超时时间 (秒)
# 默认 20 秒
AI_TIMEOUT=20

# ============================================================
# OCR 相关配置
# ============================================================
# Tesseract 可执行文件路径
# macOS (Homebrew): /usr/local/bin/tesseract 或 /opt/homebrew/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
TESSERACT_CMD=/usr/local/bin/tesseract

# Tesseract 语言包目录
# 包含 chi_sim.traineddata 等语言包文件的目录
# macOS (Homebrew): /usr/local/share/tessdata 或 /opt/homebrew/share/tessdata
# Windows: C:\Program Files\Tesseract-OCR\tessdata
# Linux: /usr/share/tesseract-ocr/4.00/tessdata
# 留空则使用系统默认路径
TESSDATA_PREFIX=

# ============================================================
# 其他配置
# ============================================================
# 每日热量目标 (千卡)
# 默认根据性别、身高、体重计算，此处可覆盖
DAILY_CALORIE_GOAL=

# 数据库路径
# 默认: data/food_nutrition.db
DB_PATH=
